ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://postgres:your_strong_password@localhost:5432/bookmyvenue_db
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost/
