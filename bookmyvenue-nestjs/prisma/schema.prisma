generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum VenueModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  venues    Venue[]
  bookings  Booking[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isListed    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  venues      Venue[]
}

model Venue {
  id               String                @id @default(uuid())
  name             String
  description      String?
  location         String
  address          String?
  pricePerHour     Float
  capacity         Int
  imageUrls        String[]
  isListed         Boolean               @default(false)
  moderationStatus VenueModerationStatus @default(PENDING)
  rejectionReason  String?
  ownerId          String
  categoryId       String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  owner            User                  @relation(fields: [ownerId], references: [id])
  category         Category              @relation(fields: [categoryId], references: [id])
  bookings         Booking[]
  cancellationWindowDays Int              @default(0)
  @@index([ownerId])
  @@index([categoryId])
  @@index([moderationStatus, isListed])
}

model Booking {
  id         String        @id @default(uuid())
  status     BookingStatus @default(PENDING)
  startTime  DateTime
  endTime    DateTime
  totalPrice Float
  userId     String
  venueId    String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue      Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([venueId])
}