generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  OWNER
  ADMIN
}

//user model
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String    
  name      String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
}

