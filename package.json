{
  "name": "bookmyvenue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BookMyVenue - Venue booking platform monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "yarn workspaces run dev",
    "dev:frontend": "yarn workspace @bookmyvenue/frontend run dev",
    "dev:backend": "yarn workspace @bookmyvenue/backend run dev",
    "build": "yarn workspaces run build",
    "build:frontend": "yarn workspace @bookmyvenue/frontend run build",
    "build:backend": "yarn workspace @bookmyvenue/backend run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "yarn workspaces run typecheck",
    "db:generate": "yarn workspace @bookmyvenue/backend run db:generate",
    "db:migrate": "yarn workspace @bookmyvenue/backend run db:migrate",
    "db:push": "yarn workspace @bookmyvenue/backend run db:push",
    "db:studio": "yarn workspace @bookmyvenue/backend run db:studio",
    "docker:up": "docker-compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker-compose.yml down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
