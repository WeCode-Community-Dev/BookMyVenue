{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@repo/domain": ["./packages/domain/src/index.ts"],
      "@repo/domain/*": ["./packages/domain/src/*"],
      "@repo/contracts": ["./packages/contracts/src/index.ts"],
      "@repo/contracts/*": ["./packages/contracts/src/*"],
      "@repo/infrastructure": ["./packages/infrastructure/src/index.ts"],
      "@repo/infrastructure/*": ["./packages/infrastructure/src/*"]
    }
  }
}
