// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  firstName String  @db.VarChar(100)
  lastName  String? @db.VarChar(100)

  email String  @unique @db.VarChar(255)
  phone String? @unique @db.VarChar(20)

  passwordHash String @db.VarChar(255)

  role   UserRole   @default(CUSTOMER)
  status UserStatus @default(PENDING_VERIFICATION)

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  phoneVerified   Boolean   @default(false)
  phoneVerifiedAt DateTime?

  avatarUrl String? @db.VarChar(500)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  lastLoginAt          DateTime?
  lastPasswordChangeAt DateTime?

  verificationTokens VerificationToken[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model VerificationToken {
  id String @id @default(uuid())

  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// =========================
// VENUES
// =========================

model Venue {
  id      String @id @default(uuid())
  ownerId String

  name        String
  description String?

  address    String
  city       String
  state      String?
  country    String
  postalCode String?

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  timezone  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaces    Space[]
  amenities VenueAmenity[]
  images    VenueImage[]
  bookings  Booking[]

  @@index([ownerId])
  @@index([city])
  @@map("venues")
}

// =========================
// SPACE CATEGORY
// =========================

model SpaceCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaces Space[]

  @@map("space_categories")
}

// =========================
// SPACES
// =========================

model Space {
  id String @id @default(uuid())

  venueId    String
  categoryId String

  name        String
  description String?

  capacityValue Decimal?
  capacityType  CapacityType?

  isActive Boolean @default(true)
  rules    String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bookingPolicy BookingPolicy @default(INSTANT_ONLY)

  venue    Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category SpaceCategory @relation(fields: [categoryId], references: [id])

  amenities           SpaceAmenity[]
  images              SpaceImage[]
  spaceOperatingHours SpaceOperatingHour[]
  spaceBlockedPeriods SpaceBlockedPeriod[]
  spacePricing        SpacePricing[]
  bookings            Booking[]

  @@index([venueId])
  @@index([categoryId])
  @@map("spaces")
}

// =========================
// AMENITIES
// =========================

model Amenity {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venueAmenities VenueAmenity[]
  spaceAmenities SpaceAmenity[]

  @@map("amenities")
}

// =========================
// VENUE AMENITIES
// =========================

model VenueAmenity {
  venueId   String
  amenityId String

  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id])

  @@id([venueId, amenityId])
  @@index([amenityId])
  @@map("venue_amenities")
}

// =========================
// SPACE AMENITIES
// =========================

model SpaceAmenity {
  spaceId   String
  amenityId String

  space   Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id])

  @@id([spaceId, amenityId])
  @@index([amenityId])
  @@map("space_amenities")
}

// =========================
// IMAGES
// =========================

model Image {
  id String @id @default(uuid())

  url     String
  altText String?

  width  Int?
  height Int?

  createdAt DateTime @default(now())

  venueImages VenueImage[]
  spaceImages SpaceImage[]

  @@map("images")
}

// =========================
// VENUE IMAGES
// =========================

model VenueImage {
  venueId String
  imageId String

  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([venueId, imageId])
  @@index([imageId])
  @@map("venue_images")
}

// =========================
// SPACE IMAGES
// =========================

model SpaceImage {
  spaceId String
  imageId String

  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([spaceId, imageId])
  @@index([imageId])
  @@map("space_images")
}

model SpaceOperatingHour {
  id String @id @default(uuid())

  spaceId String

  weekday Int // 0 = Sunday ... 6 = Saturday

  openTime String // "09:00"

  closeTime String // "18:00"

  isClosed Boolean @default(false)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, weekday])
  @@index([spaceId])
  @@map("space_operating_hours")
}

model SpaceBlockedPeriod {
  id String @id @default(uuid())

  spaceId String

  startAt DateTime
  endAt   DateTime

  reason String?

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@map("space_blocked_periods")
}

model SpacePricing {
  id String @id @default(uuid())

  spaceId String

  pricingType PricingType

  amount Decimal

  currency String

  minBooking Int?

  maxBooking Int?

  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id])

  @@map("space_pricing")
}

model Booking {
  id String @id @default(uuid())

  userId  String
  venueId String
  spaceId String

  bookingNumber String @unique

  startAt DateTime
  endAt   DateTime

  guests Int?

  pricingType PricingType
  amount      Decimal     @db.Decimal(10, 2)
  currency    String      @default("INR")

  status BookingStatus @default(PENDING)

  specialRequest String?

  ownerNote String?

  cancelledAt DateTime?
  cancelledBy UserRole?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])
  space Space @relation(fields: [spaceId], references: [id])

  @@index([userId])
  @@index([venueId])
  @@index([spaceId])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@map("bookings")
}

// =========================
// ENUMS
// =========================

enum UserRole {
  CUSTOMER
  VENUE_OWNER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CapacityType {
  PEOPLE
  SEATS
  PLAYERS
  CARS
  SQFT
  SQM
}

enum PricingType {
  HOURLY
  SESSION
  DAILY
  EVENT
  CUSTOM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum BookingPolicy {
  INSTANT_ONLY
  REQUEST_ONLY
  BOTH
}
