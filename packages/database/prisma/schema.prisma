// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  USER
}

enum District {
  THIRUVANANTHAPURAM
  KOLLAM
  PATHANAMTHITTA
  ALAPPUZHA
  KOTTAYAM
  IDUKKI
  ERNAKULAM
  THRISSUR
  PALAKKAD
  MALAPPURAM
  KOZHIKODE
  WAYANAD
  KANNUR
  KASARAGOD
}

enum VenueCategory {
  WEDDING_HALL
  CONFERENCE_HALL
  PARTY_HALL
  CAFE
  RESTAURANT
  AUDITORIUM
  SPORTS_GROUND
  MEETING_ROOM
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id      String  @id @default(uuid())
  email   String  @unique
  name    String?
  role    Role    @default(USER)

  venues   Venue[]
  bookings Booking[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Venue {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  capacity    Int

  images    String[]
  amenities String[]

  category VenueCategory

  location String
  district District

  verificationStatus VerificationStatus @default(PENDING)
  verificationReason String?

  isActive Boolean @default(true)

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  sessions VenueSession[]
  bookings Booking[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([district])
  @@index([category])
  @@index([ownerId])
}

model VenueSession {
  id Int @id @default(autoincrement())

  label     String
  startTime String
  endTime   String

  price Int

  isActive Boolean @default(true)

  venue   Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId Int

  bookingSessions BookingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

model Booking {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  venue   Venue @relation(fields: [venueId], references: [id])
  venueId Int

  purpose String?

  status BookingStatus @default(CONFIRMED)

  bookingSessions BookingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingSession {
  bookingId String
  sessionId Int

  eventDate DateTime @db.Date
  pricePaid Int

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  session VenueSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@id([bookingId, sessionId])
  @@unique([sessionId, eventDate])
  @@index([sessionId])
}

model Review {
  id String @id @default(uuid())

  venueId Int
  venue   Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  rating Int

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, userId])
  @@index([venueId])
}
