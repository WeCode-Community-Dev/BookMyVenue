// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  VENUE_OWNER
  ADMIN
}

enum VenueStatus {
  PENDING_DOCUMENTS
  PENDING
  APPROVED
  REJECTED
}

enum VenueCategory {
  WEDDING
  BIRTHDAY
  CONFERENCE
  SPORTS
  PARTY
  AUDITORIUM
  RESORT
  MEETING
  OTHER
}

enum VenueAmenity {
  WIFI
  PARKING
  AIR_CONDITIONING
  CATERING
  RESTROOM
  SOUND_SYSTEM
  PROJECTOR
  STAGE
  GENERATOR
  OTHER
}

enum VenueDocumentType {
  GOVERNMENT_ID
  PROPERTY_DOCUMENT
}

enum BookingStatus {
  PENDING_OWNER_APPROVAL
  PENDING_PAYMENT
  CONFIRMED
  REJECTED
  CANCELLED_BY_USER
  CANCELLED_BY_OWNER
  PAYMENT_EXPIRED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
}

enum BlockType {
  FULL_DAY
  TIME_SLOT
}

model User {
  id               String  @id @default(uuid())
  email            String  @unique
  passwordHash     String?
  refreshTokenHash String?
  googleId         String? @unique

  role Role @default(USER)

  isEmailVerified         Boolean   @default(false)
  emailVerifyExpiry       DateTime?
  emailVerifyOtp          String?
  forgotPasswordOtp       String?
  forgotPasswordOtpExpiry DateTime?

  profile Profile?

  venues Venue[]

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  profilePicture String?

  phoneNumber String?
  dateOfBirth DateTime?
  gender      String?
  biography   String?

  address String?
  city    String?
  state   String?
  country String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Venue {
  id String @id @default(uuid())

  name        String
  description String?

  city    String
  address String

  latitude  Float?
  longitude Float?

  capacity Int?
  price    Float?

  bookingApprovalRequired Boolean @default(false)

  categories VenueCategory[]
  amenities  VenueAmenity[]

  status          VenueStatus @default(PENDING_DOCUMENTS)
  rejectionReason String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  images    VenueImage[]
  documents VenueDocument[]

  bookings     Booking[]
  blockedSlots VenueBlockedSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VenueImage {
  id String @id @default(uuid())

  imageUrl String

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model VenueDocument {
  id String @id @default(uuid())

  type        VenueDocumentType
  documentUrl String

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Booking {
  id String @id @default(uuid())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventStart DateTime
  eventEnd   DateTime

  eventName       String
  guestCount      Int
  specialRequests String?

  totalAmount Float

  status        BookingStatus @default(PENDING_OWNER_APPROVAL)
  paymentStatus PaymentStatus @default(PENDING)

  paymentExpiresAt DateTime?

  cancellationReason String?

  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VenueBlockedSlot {
  id String @id @default(uuid())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  blockType BlockType

  startDate DateTime
  endDate   DateTime

  reason String?

  createdAt DateTime @default(now())
}

model Payment {
  id String @id @default(uuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  amount Float

  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
